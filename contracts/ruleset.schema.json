{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "隐私检测规则集",
  "type": "object",
  "required": ["rule_set_id", "version", "source_context", "rules"],
  "properties": {
    "rule_set_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source_context": {
      "type": "object",
      "required": ["domain", "version", "sample_id"],
      "description": "规则来源的领域资料标识，规则集中的每条规则必须溯源到其中一条事实记录",
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sample_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "title", "source_fact", "evaluator"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source_fact": {
            "type": "string",
            "minLength": 1,
            "description": "该规则溯源的领域事实原文"
          },
          "evaluator": {
            "type": "string",
            "minLength": 1,
            "description": "代码中注册的求值器名称"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
