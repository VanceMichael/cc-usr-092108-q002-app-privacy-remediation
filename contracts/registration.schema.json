{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "客户端整改登记",
  "type": "object",
  "required": [
    "app_id",
    "operator",
    "notice_published_at",
    "channels",
    "versions"
  ],
  "properties": {
    "app_id": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "notice_published_at": {
      "type": "string",
      "format": "date-time",
      "description": "通报发布时间，十五个工作日期限自次日起算"
    },
    "channels": {
      "type": "object",
      "minItems": 1,
      "description": "按渠道登记的发布事件；只有生效事件（approved/gray/full/hot_update）决定版本何时生效，提交审核（submitted）不生效",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "releases"],
        "properties": {
          "kind": {
            "enum": ["app", "miniapp"]
          },
          "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["event", "version", "occurred_at"],
              "properties": {
                "event": {
                  "enum": ["submitted", "approved", "gray", "full", "hot_update"]
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "occurred_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "灰度覆盖率，仅 gray 事件使用"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "versions": {
      "type": "object",
      "minItems": 1,
      "description": "每个版本登记的个人信息规则、权限用途、采集字段、第三方组件与注销路径",
      "additionalProperties": {
        "type": "object",
        "required": [
          "privacy_policy",
          "permissions",
          "collection_fields",
          "third_party_components",
          "cancellation"
        ],
        "properties": {
          "privacy_policy": {
            "type": "object",
            "required": ["published", "version"],
            "properties": {
              "published": {"type": "boolean"},
              "version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "purpose", "essential"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "purpose": {"type": "string", "minLength": 1},
                "essential": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "collection_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "purpose", "essential"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "purpose": {"type": "string", "minLength": 1},
                "essential": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "third_party_components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "version", "collects"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "collects": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": false
            }
          },
          "cancellation": {
            "type": "object",
            "required": ["entry", "max_steps", "sla_working_days"],
            "properties": {
              "entry": {"type": "string", "minLength": 1},
              "max_steps": {"type": "integer", "minimum": 1},
              "sla_working_days": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "deadline_extensions": {
      "type": "array",
      "description": "法定期限顺延事件，按发生时间应用",
      "items": {
        "type": "object",
        "required": ["occurred_at", "working_days", "basis"],
        "properties": {
          "occurred_at": {"type": "string", "format": "date-time"},
          "working_days": {"type": "integer", "minimum": 1},
          "basis": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
