{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "期限事件资料",
  "type": "object",
  "required": ["notices", "extensions", "holidays"],
  "properties": {
    "notices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["app_id", "channel", "notice_date", "issues"],
        "properties": {
          "app_id": {"type": "string", "minLength": 1},
          "channel": {"type": "string", "minLength": 1},
          "notice_date": {"type": "string"},
          "issues": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "base_working_days": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["occurred_at", "extra_working_days"],
        "properties": {
          "occurred_at": {"type": "string"},
          "extra_working_days": {"type": "integer", "minimum": 1},
          "reason": {"type": "string"},
          "recorded_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "holidays": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
